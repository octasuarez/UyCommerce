{
  "ConnectionStrings": {
    "Default": "Server=YOUR_DB_SERVER;Port=YOUR_DB_PORT;Database=YOUR_DB_NAME;Uid=YOUR_DB_USER;Pwd=YOUR_DB_PASSWORD;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "paypal": {
    "settings": {
      "clientId": "YOUR_PAYPAL_CLIENT_ID",
      "secretKey": "YOUR_PAYPAL_SECRET_KEY",
      "email": "YOUR_PAYPAL_ACCOUNT_EMAIL",
      "password": "YOUR_PAYPAL_ACCOUNT_PASSWORD",
      "sandboxUrl": "https://api-m.sandbox.paypal.com",
      "liveUrl": "https://api-m.paypal.com"
    }
  },
  "EmailConfiguration": {
    "From": "YOUR_EMAIL_ADDRESS",
    "SmtpServer": "smtp.gmail.com", //TO USE WITH YOUR GMAIL ACCOUNT, CHANGE IT IF YOU HAVE ANOTHER SERVICE
    "Port": 465,
    "Username": "YOUR_USERNAME",
    "Password": "YOUR_UNIQUE_GMAIL_APP_PASSWORD"
  },
  "RecuperacionPasswordAsunto": "UyCommerce Recuperacion Contraseña",
  "RecuperacionPasswordBody": "Usted solicito cambiar su contraseña. Sigue este enlace para cambiarlo: #URL#/#TOKEN#",
  "CambioPasswordAsunto": "Cambio de contraseña",
  "CambioPasswordBody": "Cambió su contraseña de UYCommerce"
}