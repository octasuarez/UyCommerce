<body class="bg-white">

    <div class="container" style="height:100%;">

        <h1 class="text-center" style="margin-bottom:20px;margin-top:50px;">@Localizer["Contact us"]</h1>
        <div class="d-flex">

            <div class="col-6">
                <div class="my-5">
                    <h2 class="text-center">Info</h2>

                    <div class="my-4 w-75 mx-auto">
                        <p><i class="bi bi-phone"></i> @Localizer["Phone:"]:<a class=""
                                                                                   href="tel:+59892295820">(+598)92295820</a></p>
                            <p><i class="bi bi-geo-alt"></i> Direccion: Las Toscas, Canelones</p>
                            <p><i class="bi bi-envelope-at"></i> Email:<a
                                href="mailto:octasuarezp@gmail.com">octasuarezp@gmail.com</a></p>
                                <p><i class="bi bi-linkedin"></i> linkedin: <a target="_blank"
                                                                                   href="https://www.linkedin.com/in/octavio-su%C3%A1rez-pamparatto">www.linkedin.com/in/octavio-suarez-pamparatto</a>
                                </p>

                            </div>
                        </div>
                    </div>


                    <div class="col-6 p-5">
                        <form class="card p-5 shadow" id="contactForm" method="post" asp-action="Contacto"
                              asp-controller="Home">
                            <h2 class="text-center mb-3">Online <i class="bi bi-envelope-at"></i></h2>
                            <div class="d-flex flex-column">

                                <input id="Asunto" class="form-control mb-3" type="text" placeholder="@Localizer["Subject"]"
                                       name="Asunto" />
                                <input id="Nombre" class="form-control mb-3" type="text" placeholder="@Localizer["Name"]"
                                       name="Nombre" />
                                <textarea id="Mensaje" rows="5" class="form-control mb-3" type="text"
                                          placeholder="@Localizer["Message"]" name="Mensaje" style="resize:none;"></textarea>

                                <div id="send" class="mx-auto">
                                    <button type="button" onclick="Contacto()" class="btn btn-dark">@Localizer["Send"]</button>
                                </div>


                                <div class="mt-3">
                                    <span class="text-danger" id="errors"></span>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div id="map" style="height:400px;width:100%;"></div>
            </div>
            @section Scripts {
                <script src="~/js/pages/home/contacto.js"></script>
            }

        </body>