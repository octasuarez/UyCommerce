@{
    Layout = "EmptyLayout";
}
@model PasswordRecuperacionModel

<body>
    <div class="container pt-5">
        <div class="card-body col-5 mx-auto mt-5 d-flex flex-column">
            <form method="post" asp-action="CambiarPasswordRecuperacion">
                <input hidden type="text" value="@Model.Codigo" readonly name="Codigo" />
                <div class="form-floating mb-3">
                    <input class="form-control" type="email" name="Email" placeholder="" />
                    <label for="Email">Email</label>
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="form-floating mb-3">
                    <input class="form-control" type="text" name="Password" placeholder="" />
                    <label for="Password">New Password</label>
                    <span asp-validation-for="Password"></span>
                </div>
                <div>
                <button class="btn btn-primary d-flex mx-auto w-100 justify-content-center my-3"
                        type="submit">@Localizer["Confirm"]
                </button>

                </div>
            </form>
        </div>
    </div>
</body>